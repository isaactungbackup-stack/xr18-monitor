<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="6dp"
    android:paddingHorizontal="4dp"
    android:background="#1a1a1a"
    android:layout_marginBottom="2dp">

    <!-- Channel number -->
    <TextView
        android:id="@+id/tv_ch_num"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:text="CH01"
        android:textColor="#AAA"
        android:textSize="13sp"
        android:fontFamily="monospace" />

    <!-- Fader seekbar (0-100) -->
    <SeekBar
        android:id="@+id/sb_fader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginHorizontal="8dp"
        android:max="100"
        android:progress="70"
        android:progressTint="#4CAF50"
        android:thumbTint="#4CAF50" />

    <!-- Fader dB label -->
    <TextView
        android:id="@+id/tv_db"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:text="–3.0 dB"
        android:textColor="#AAFFAA"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:gravity="end" />

    <!-- Gain dB label -->
    <TextView
        android:id="@+id/tv_gain"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:text="+60.0 dB"
        android:textColor="#FFFF88"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:gravity="end"
        android:layout_marginStart="4dp" />

    <!-- Meter SeekBar -->
    <SeekBar
        android:id="@+id/sb_meter"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.6"
        android:layout_marginHorizontal="6dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#FF8800"
        android:thumbTint="#FF8800" />

    <!-- Meter dB label -->
    <TextView
        android:id="@+id/tv_meter_db"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:text="–∞ dB"
        android:textColor="#FFAA44"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:gravity="end"
        android:layout_marginStart="2dp" />

    <!-- Mute indicator -->
    <TextView
        android:id="@+id/tv_mute"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="6dp"
        android:gravity="center"
        android:text="MUT"
        android:textSize="11sp"
        android:textStyle="bold"
        android:background="#333333"
        android:textColor="#666666" />

</LinearLayout>