<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#111122"
    android:padding="0dp">

    <!-- Title bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="#1A1A2E">

        <TextView
            android:id="@+id/tv_channel_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CH01 — Spectrogram"
            android:textColor="#CCCCCC"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_meter_db"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="–∞ dB"
            android:textColor="#00FF88"
            android:textSize="12sp"
            android:fontFamily="monospace" />

        <View
            android:layout_width="12dp"
            android:layout_height="0dp" />

        <Button
            android:id="@+id/btn_close"
            android:layout_width="40dp"
            android:layout_height="28dp"
            android:text="✕"
            android:textSize="12sp"
            android:paddingHorizontal="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />

    </LinearLayout>

    <!-- Spectrogram + RTA view -->
    <com.mixer.xr18.app.SpectrogramView
        android:id="@+id/spectrogram_view"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_marginHorizontal="4dp"
        android:layout_marginTop="4dp" />

    <!-- EQ Band controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp"
        android:background="#0D0D1A">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EQ Bands"
            android:textColor="#888888"
            android:textSize="10sp"
            android:fontFamily="monospace" />

        <!-- Band 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <TextView
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:text="Low"
                android:textColor="#BBBBBB"
                android:textSize="11sp"
                android:fontFamily="monospace" />

            <SeekBar
                android:id="@+id/seek_eq_b1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="50"
                android:progressTint="#00CCFF"
                android:thumbTint="#00CCFF" />

            <TextView
                android:id="@+id/tv_eq_b1"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:text="0.0 dB"
                android:textColor="#00CCFF"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:gravity="end" />

        </LinearLayout>

        <!-- Band 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <TextView
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:text="LMid"
                android:textColor="#BBBBBB"
                android:textSize="11sp"
                android:fontFamily="monospace" />

            <SeekBar
                android:id="@+id/seek_eq_b2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="50"
                android:progressTint="#44FF44"
                android:thumbTint="#44FF44" />

            <TextView
                android:id="@+id/tv_eq_b2"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:text="0.0 dB"
                android:textColor="#44FF44"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:gravity="end" />

        </LinearLayout>

        <!-- Band 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <TextView
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:text="HMid"
                android:textColor="#BBBBBB"
                android:textSize="11sp"
                android:fontFamily="monospace" />

            <SeekBar
                android:id="@+id/seek_eq_b3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="50"
                android:progressTint="#FFAA00"
                android:thumbTint="#FFAA00" />

            <TextView
                android:id="@+id/tv_eq_b3"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:text="0.0 dB"
                android:textColor="#FFAA00"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:gravity="end" />

        </LinearLayout>

        <!-- Band 4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <TextView
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:text="High"
                android:textColor="#BBBBBB"
                android:textSize="11sp"
                android:fontFamily="monospace" />

            <SeekBar
                android:id="@+id/seek_eq_b4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="50"
                android:progressTint="#FF4444"
                android:thumbTint="#FF4444" />

            <TextView
                android:id="@+id/tv_eq_b4"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:text="0.0 dB"
                android:textColor="#FF4444"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:gravity="end" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>